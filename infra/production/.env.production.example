# Copier en .env.production (jamais dans Git) et remplir. Voir docs/DEPLOIEMENT.md.
# Générer les secrets : python -c "import secrets; print(secrets.token_urlsafe(48))"

# Domaine : app. (XPASS), admin., rh., pro. (commerçant), api., auth. en DNS de type A.
DOMAIN=xpass.fr
ACME_EMAIL=technique@xpass.fr

# Base de données
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Keycloak (console d'administration : tunnel SSH uniquement)
KEYCLOAK_ADMIN_USER=xpass-admin
KEYCLOAK_ADMIN_PASSWORD=
# Même valeur que --portals-secret de make_realm.py (32 caractères minimum)
OIDC_PORTALS_CLIENT_SECRET=
OIDC_AUDIENCE=xpass-api

# E-mails (fournisseur SMTP : Brevo, Mailjet, Amazon SES, Postmark…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=XPASS <no-reply@xpass.fr>

# Stockage des photos (tout service compatible S3 : Scaleway, OVHcloud, AWS…)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=fr-par
S3_PUBLIC_BUCKET=xpass-public
S3_PRIVATE_BUCKET=xpass-private
# Adresse publique du bucket public (photos affichées dans l'app et les portails)
MEDIA_BASE_URL=

# Paiement (Stripe). Commencez en mode test (sk_test_…), passez en sk_live_… après les essais.
PSP_PROVIDER=stripe
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=
PSP_CONNECT_WEBHOOK_SECRET=
PSP_PRICE_ESSENTIEL=

# Notifications sur téléphone (facultatif) : chemin du JSON du compte de service Firebase dans le conteneur
FCM_SERVICE_ACCOUNT_FILE=

# Suivi des erreurs (facultatif) : adresse DSN Sentry
SENTRY_DSN=

# Lien « Besoin d’aide ? » des portails, et pages légales validées par un juriste (retire le bandeau).
SUPPORT_EMAIL=solvarynlabs@gmail.com
LEGAL_VALIDATED=false

# Connexion « Continuer avec Google » (identifiant OAuth Google Cloud, voir docs/CONNEXION_GOOGLE.md).
# Après modification : docker compose up -d keycloak, puis infra/keycloak/activer-google.sh.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
