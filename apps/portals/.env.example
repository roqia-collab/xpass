# Copier en .env.local :  copy .env.example .env.local
# URL de l'API FastAPI, appelée UNIQUEMENT côté serveur (BFF). Jamais exposée au navigateur.
XPASS_API_URL=http://localhost:8000
# URL publique des médias (bucket public)
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8333/xpass-public

# Connexion OIDC (Keycloak local de docker compose). Secret côté serveur uniquement.
OIDC_ISSUER=http://localhost:8080/realms/xpass
# Adresse Keycloak vue par le navigateur (hébergement de test). Vide = OIDC_ISSUER.
OIDC_ISSUER_PUBLIC=
OIDC_PORTALS_CLIENT_ID=xpass-portals
OIDC_PORTALS_CLIENT_SECRET=dev-portals-secret-0123456789abcdef
PORTALS_PUBLIC_URL=http://localhost:3000
# Application client (Flutter) : lien « App client » dans les portails.
APP_PUBLIC_URL=http://localhost:5174

# Adresse du lien « Besoin d’aide ? » de la page de connexion (sinon : mentions légales).
SUPPORT_EMAIL=
