# Copier en .env :  copy .env.example .env
# Aucun secret réel ici. Valeurs de développement local uniquement.

APP_ENV=development
# Connexion de démonstration sans fournisseur OIDC. Refusée au démarrage si APP_ENV=production.
AUTH_DEV_LOGIN_ENABLED=false
# Clé de signature des jetons de DÉVELOPPEMENT. Générer une valeur longue et aléatoire.
JWT_DEV_SECRET=change-me-dev-only-0123456789abcdef0123456789abcdef

POSTGRES_PASSWORD=xpass_dev

# Bus d'événements. Dans Docker Compose, l'adresse interne est imposée (kafka:29092).
# Vide = l'outbox envoie les e-mails sans publier sur Kafka.
KAFKA_BOOTSTRAP_SERVERS=

# Stockage compatible S3 (SeaweedFS en local, voir infra/storage/s3.json)
S3_ACCESS_KEY=xpass_s3_dev
S3_SECRET_KEY=xpass_s3_dev_secret
# URL publique des médias vue par le navigateur / l'émulateur
MEDIA_BASE_URL=http://localhost:8333/xpass-public
S3_PUBLIC_BUCKET=xpass-public
S3_PRIVATE_BUCKET=xpass-private

# Origines autorisées (portails web en local)
CORS_ORIGINS=http://localhost:3000

# ---- À configurer plus tard (laisser vide tant que non fourni) ----
# Fournisseur OIDC. En local : Keycloak de docker compose (realm « xpass »).
# L'émetteur est l'adresse vue par le navigateur ; le JWKS est lu par l'API à l'intérieur de Docker.
OIDC_ISSUER=http://localhost:8080/realms/xpass
OIDC_AUDIENCE=xpass-api
OIDC_JWKS_URL=http://keycloak:8080/realms/xpass/protocol/openid-connect/certs
# Portails (Next.js, côté serveur uniquement)
OIDC_PORTALS_CLIENT_ID=xpass-portals
OIDC_PORTALS_CLIENT_SECRET=dev-portals-secret-0123456789abcdef
# E-mails transactionnels. En local : Mailpit (capture, aucun envoi réel). Vide = aucun e-mail.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=XPASS <no-reply@xpass.local>
# Prestataire de paiement (lot 4).
#   sandbox : bac à sable LOCAL, aucun argent, webhooks signés produits localement (refusé en production)
#   stripe  : clé secrète (sk_test_... en test), secret de signature des webhooks (whsec_...),
#             et identifiant du tarif de la formule Essentiel (price_...)
PSP_PROVIDER=sandbox
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=whsec_dev_remplacez_par_une_valeur_aleatoire
# Stripe Connect : secret de l'endpoint « comptes connectés » (événements account.updated).
PSP_CONNECT_WEBHOOK_SECRET=
PSP_PRICE_ESSENTIEL=
# Adresses publiques pour les retours du paiement hébergé
API_PUBLIC_URL=http://localhost:8000
APP_PUBLIC_URL=http://localhost:5173
# Retour du commerçant après la page du prestataire (compte de versement).
PORTALS_PUBLIC_URL=http://localhost:3000
# Cartographie (écran « Autour de moi », lot 8)
MAPS_API_KEY=

# Connexion « Continuer avec Google » (identifiant OAuth Google Cloud, voir docs/CONNEXION_GOOGLE.md).
# Après modification : docker compose up -d keycloak, puis infra/keycloak/activer-google.sh.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
